          "id": "ma-asbaha-bi",
          "fadl": "من قالها حين يصبح فقد أدى شكر يومه"
        },
        {
          "id": "asbahtu-fi-nimah",
          "num": 3,
          "fadl": "ثَلاثَ مَرَّاتٍ إذا أصبَحَ وإذا أمسى، كان حَقًّا على اللهِ أن يُتِمَّ عليه نِعمَتَه"
        },
        {
          "id": "hamm-wal-hazan",
          "fadl": "ألا أعلمُكَ كلامًا إذا قلتَه أذهَب اللهُ تعالى همَّكَ وقضى عنكَ دَينَكَ ؟ قُلْ إذا أصبَحتَ وإذا أمسَيتَ ؛ اللهم إني أعوذُ بكَ…"
        },
        {
          "id": "afiyah"
        },
        {
          "id": "sayyid-al-istighfar",
          "fadl": "سيد الاستغفار، من قالها موقنًا بها حين يصبح فمات من يومه دخل الجنة"
        },
        {
          "id": "fatir-as-samawat"
        },
        {
          "id": "asbahtu-ushhiduk",
          "num": 4,
          "fadl": "من قالها حين يصبح أعتق الله ربعه من النار، فإن قالها أربعاً أعتقه الله من النار"
        },
        {
          "id": "tahleel",
          "num": 100,
          "fadl": "كانت له عدل عشر رقاب، وكتبت له مائة حسنة، ومحيت عنه مائة سيئة، وكانت له حرزاً من الشيطان يومه ذلك حتى يمسي"
        },
        {
          "id": "hasbiyallah",
          "num": 7,
          "fadl": "إلَّا كفاه اللهُ ما همَّهُ"
        },
        {
          "id": "hasbiyallah-wa-kafa"
        },
        {
          "id": "subhanallah-wa-bihamdih",
          "num": 100,
          "fadl": "حطت خطياه ولو كانت مثل زبد البحر"
        },
        {
          "id": "astaghfirullah-wa-atubu",
          "num": 100
        }
