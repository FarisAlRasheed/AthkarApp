          "id": "bismillah-awwalahu-wa-akhirahu",
          "hadith": "baz-awwalahu",
          "note": "إن نسي أن يذكر الله في أوله"
        },
        {
          "guide": "إن الله ليرضى عن العبد أن يأكل الأكلة فيحمده عليها، أو يشرب الشربة فيحمده عليها",
          "hadith": "baz-yarda"
        },
        {
          "id": "atamani-hadha",
          "hadith": "hisn-180",
          "fadl": "غفر له ما تقدم من ذنبه"
        },
