        }
      ]
    },
    {
      "title": "ما يشرع من الذكر والدعاء عند الأذان وبعده",
      "sections": [
        "adhan"
      ],
      "entries": [
        {
          "guide": "إذا سمعتم النداء فقولوا مثل ما يقول المؤذن",
          "hadith": "baz-nida"
        },
        {
          "id": "hawqala",
          "hadith": "baz-umar-adhan",
          "note": "عند «حيّ على الصلاة» و«حيّ على الفلاح»، ويقول مثل ما يقول المؤذن فيما سواهما"
        },
        {
          "id": "adhan-ashhadu",
          "hadith": "hisn-23",
          "note": "حين يسمع المؤذن"
        },
        {
          "guide": "ثم صلّوا على النبي ﷺ؛ فإنه من صلّى عليه صلاة صلى الله عليه بها عشرًا، ثم سلوا الله له الوسيلة",
          "hadith": "baz-wasila"
        },
        {
          "id": "adhan-al-wasila",
          "hadith": "hisn-25",
          "fadl": "حلّت له شفاعتي يوم القيامة"
        }
      ]
    },
    {
      "title": "مشروعية السلام بدءًا وإجابة، وتشميت العاطس إذا حمد الله، وعيادة المريض",
      "sections": [
        "salam",
        "sneeze",
        "sick"
      ],
      "entries": [
        {
          "guide": "تطعم الطعام، وتقرأ السلام على من عرفت ومن لم تعرف",
          "hadith": "baz-salam-1"
        },
        {
          "guide": "أفشوا السلام بينكم",
          "hadith": "baz-salam-2"
        },
        {
          "guide": "حق المسلم على المسلم ست: إذا لقيته فسلّم عليه، وإذا دعاك فأجبه، وإذا استنصحك فانصحه، وإذا عطس فحمد الله فشمّته، وإذا مرض فعُده، وإذا مات فاتبعه",
          "hadith": "baz-haqq-al-muslim"
        },
        {
          "id": "alhamdulillah",
          "hadith": "hisn-188",
          "note": "يقوله العاطس",
          "only": "sneeze"
        },
        {
          "id": "yarhamukallah",
          "hadith": "hisn-188",
          "note": "يقوله له أخوه أو صاحبه",
          "only": "sneeze"
        },
        {
          "id": "yahdikumullah",
          "hadith": "hisn-188",
          "note": "ويردّ العاطس",
          "only": "sneeze"
        },
        {
          "guide": "إذا عطس أحدكم فحمد الله فشمّتوه، فإن لم يحمد الله فلا تشمّتوه",
          "hadith": "baz-tashmit"
        },
        {
          "guide": "التثاؤب من الشيطان، فإذا تثاءب أحدكم فليمسك بيده على فيه ما استطاع",
          "hadith": "baz-tathawub"
        }
      ]
    }
