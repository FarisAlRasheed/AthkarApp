    "morning": {
      "title": "أذكار الصباح",
      "resetAt": "fajr",
      "opening": {
        "ayahs": {
          "sura": 30,
          "from": 17,
          "to": 17
        },
        "text": "فَسُبۡحَٰنَ ٱللَّهِ حِينَ تُمۡسُونَ وَحِينَ تُصۡبِحُونَ ۝١٧"
      },
      "group": "daily",
      "kind": "wird"
    },
    "evening": {
      "title": "أذكار المساء",
      "resetAt": "asr",
      "opening": {
        "ayahs": {
          "sura": 50,
          "from": 39,
          "to": 39
        },
        "text": "فَٱصۡبِرۡ عَلَىٰ مَا يَقُولُونَ وَسَبِّحۡ بِحَمۡدِ رَبِّكَ قَبۡلَ طُلُوعِ ٱلشَّمۡسِ وَقَبۡلَ ٱلۡغُرُوبِ ۝٣٩"
      },
      "group": "daily",
      "kind": "wird"
    },
    "post-prayer": {
      "title": "أذكار بعد الصلاة",
      "resetAt": "each-prayer",
      "opening": {
        "ayahs": {
          "sura": 4,
          "from": 103,
          "to": 103
        },
        "text": "فَإِذَا قَضَيۡتُمُ ٱلصَّلَوٰةَ فَٱذۡكُرُواْ ٱللَّهَ قِيَٰمࣰا وَقُعُودࣰا وَعَلَىٰ جُنُوبِكُمۡۚ فَإِذَا ٱطۡمَأۡنَنتُمۡ فَأَقِيمُواْ ٱلصَّلَوٰةَۚ إِنَّ ٱلصَّلَوٰةَ كَانَتۡ عَلَى ٱلۡمُؤۡمِنِينَ كِتَٰبࣰا مَّوۡقُوتࣰا ۝١٠٣"
      },
      "group": "daily",
      "kind": "wird"
    },
    "sleep": {
      "title": "أذكار النوم",
      "resetAt": "isha",
      "opening": {
        "ayahs": {
          "sura": 3,
          "from": 191,
          "to": 191
        },
        "text": "ٱلَّذِينَ يَذۡكُرُونَ ٱللَّهَ قِيَٰمࣰا وَقُعُودࣰا وَعَلَىٰ جُنُوبِهِمۡ وَيَتَفَكَّرُونَ فِي خَلۡقِ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ رَبَّنَا مَا خَلَقۡتَ هَٰذَا بَٰطِلࣰا سُبۡحَٰنَكَ فَقِنَا عَذَابَ ٱلنَّارِ ۝١٩١"
      },
      "group": "daily",
      "kind": "wird"
    },
